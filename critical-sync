#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'


# Defaults (used unless overridden by config)

# Exclude patterns you never want to copy
EXCLUDES_DEFAULT=(
  ".Trash*"
  "@eaDir"
  ".DS_Store"
)

# 0 = rsync default (size+mtime), 1 = checksum (slower but thorough)
USE_CHECKSUM_DEFAULT=1


# Config path resolution
# - If run via sudo from a user, prefer that users ~/.config
resolve_config_base() {
  local base
  base="${XDG_CONFIG_HOME:-$HOME/.config}"

  # If running as root via sudo, prefer the invoking users config directory
  if [[ "$(id -u)" -eq 0 && -n "${SUDO_USER:-}" && "${HOME:-}" == "/root" ]]; then
    local sudohome
    sudohome="$(getent passwd "$SUDO_USER" | cut -d: -f6 || true)"
    if [[ -n "$sudohome" ]]; then
      base="$sudohome/.config"
    fi
  fi

  echo "$base"
}

# Allow explicit config file override (useful for systemd services)
if [[ -n "${CRITICAL_SYNC_CONFIG_FILE:-}" ]]; then
  CONFIG_FILE="$CRITICAL_SYNC_CONFIG_FILE"
  CONFIG_DIR="$(dirname "$CONFIG_FILE")"
  CONFIG_BASE="$(dirname "$CONFIG_DIR")"
else
  CONFIG_BASE="$(resolve_config_base)"
  CONFIG_DIR="$CONFIG_BASE/critical-sync"
  CONFIG_FILE="$CONFIG_DIR/critical-sync.conf"
fi

# CLI flags
DRY_RUN=0
DO_INIT=0

for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    --init)    DO_INIT=1 ;;
    *)
      echo "Unknown argument: $arg" >&2
      echo "Usage: $0 [--init] [--dry-run]" >&2
      exit 2
      ;;
  esac
done


# Helpers

need_cmd() { command -v "$1" >/dev/null 2>&1 || { echo "Missing command: $1" >&2; exit 2; }; }

need_cmd find
need_cmd rsync
need_cmd flock
need_cmd ssh
need_cmd stat
need_cmd mkdir
need_cmd date
need_cmd tee

is_tty() { [[ -t 0 && -t 1 ]]; }

tolower() { tr '[:upper:]' '[:lower:]'; }

ask_yn() {
  # ask_yn "Question" default(Y/N)
  local prompt="$1"
  local def="${2:-Y}"
  local def_lc
  def_lc="$(echo "$def" | tolower)"

  local suffix
  if [[ "$def_lc" == "y" ]]; then suffix=" [Y/n]"; else suffix=" [y/N]"; fi

  while true; do
    read -r -p "${prompt}${suffix} " ans || return 1
    ans="$(echo "${ans:-}" | tolower)"
    if [[ -z "$ans" ]]; then ans="$def_lc"; fi
    case "$ans" in
      y|yes) return 0 ;;
      n|no)  return 1 ;;
      *) echo "Please answer y or n." ;;
    esac
  done
}

prompt_nonempty() {
  # prompt_nonempty "Prompt" outvar
  local prompt="$1"
  local __outvar="$2"
  local input=""

  while true; do
    read -r -p "$prompt " input || return 1
    input="${input#"${input%%[![:space:]]*}"}"   # ltrim
    input="${input%"${input##*[![:space:]]}"}"   # rtrim
    if [[ -n "$input" ]]; then
      printf -v "$__outvar" '%s' "$input"
      return 0
    fi
  done
}

USER_HOME="${HOME:-/root}"
if [[ "$(id -u)" -eq 0 && -n "${SUDO_USER:-}" && "${HOME:-}" == "/root" ]]; then
  sudohome="$(getent passwd "$SUDO_USER" | cut -d: -f6 || true)"
  [[ -n "$sudohome" ]] && USER_HOME="$sudohome"
fi

# SSH identity/known_hosts handling (important when running under sudo)
SSH_USER_HOME="$USER_HOME"  # USER_HOME already resolves sudo-invoking user's home
SSH_IDENTITY="${SSH_IDENTITY:-$SSH_USER_HOME/.ssh/id_ed25519}"
SSH_KNOWN_HOSTS="${SSH_KNOWN_HOSTS:-$SSH_USER_HOME/.ssh/known_hosts}"

SSH_BASE_OPTS=(
  -o BatchMode=yes
  -o ConnectTimeout=5
  -o IdentitiesOnly=yes
  -i "$SSH_IDENTITY"
  -o UserKnownHostsFile="$SSH_KNOWN_HOSTS"
)
RSYNC_SSH="ssh $(printf '%q ' "${SSH_BASE_OPTS[@]}")"


norm_path() {
  # Expand only "~" and "~/" 
  local p="$1"
  if [[ "$p" == "~" ]]; then
    echo "$USER_HOME"
  elif [[ "$p" == "~/"* ]]; then
    echo "$USER_HOME/${p:2}"
  else
    echo "$p"
  fi
}


fs_id() {
  # device id for filesystem; same => same filesystem
  stat -c %d -- "$1"
}

warn_if_same_fs_any_source() {
  local backup_root="$1"
  shift
  local sources=("$@")

  local b_id
  b_id="$(fs_id "$backup_root")"

  local s
  for s in "${sources[@]}"; do
    if [[ -d "$s" ]]; then
      local s_id
      s_id="$(fs_id "$s")"
      if [[ "$s_id" == "$b_id" ]]; then
        echo "WARNING: local backup path '$backup_root' is on the SAME filesystem as source '$s' (device id=$b_id)" >&2
        echo "         This is not a true separate-disk backup for that source." >&2
        return 0
      fi
    fi
  done
}

write_array_block() {
  # write_array_block NAME elements
  local name="$1"; shift
  echo "${name}=("
  local x
  for x in "$@"; do
    # %q makes it safe to source with bash
    printf "  %q\n" "$x"
  done
  echo ")"
}


# Notifications
notify() {
  local msg="$1"
  echo "NOTIFY: $msg" >&2
  if command -v logger >/dev/null 2>&1; then
    logger -t critical-sync -- "$msg" || true
  fi
}


SCRIPT_SELF="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"

prompt_default() {
  # prompt_default "Prompt" "default" outvar
  local prompt="$1"
  local def="$2"
  local __outvar="$3"
  local input=""
  read -r -p "$prompt [$def]: " input || return 1
  input="${input#"${input%%[![:space:]]*}"}"
  input="${input%"${input##*[![:space:]]}"}"
  [[ -z "$input" ]] && input="$def"
  printf -v "$__outvar" '%s' "$input"
}

prompt_int_default() {
  # prompt_int_default "Prompt" default outvar
  local prompt="$1"
  local def="$2"
  local __outvar="$3"
  local input=""
  while true; do
    read -r -p "$prompt [$def]: " input || return 1
    input="${input#"${input%%[![:space:]]*}"}"
    input="${input%"${input##*[![:space:]]}"}"
    [[ -z "$input" ]] && input="$def"
    if [[ "$input" =~ ^[0-9]+$ ]]; then
      printf -v "$__outvar" '%s' "$input"
      return 0
    fi
    echo "Please enter an integer."
  done
}

install_self() {
  # install_self <src> <dst>
  local src="$1"
  local dst="$2"
  local dstdir
  dstdir="$(dirname "$dst")"

  need_cmd install

  if [[ "$(id -u)" -eq 0 ]]; then
    mkdir -p "$dstdir"
    install -m 0755 "$src" "$dst"
    return 0
  fi

  # Non-root: use sudo only for system paths
  if [[ "$dst" == /usr/* || "$dst" == /bin/* || "$dst" == /sbin/* || "$dst" == /usr/local/* ]]; then
    need_cmd sudo
    sudo mkdir -p "$dstdir"
    sudo install -m 0755 "$src" "$dst"
  else
    mkdir -p "$dstdir"
    install -m 0755 "$src" "$dst"
  fi
}

create_systemd_timer() {
  # create_systemd_timer mode unit exec_path cfg_path ssh_key ssh_known interval_min boot_delay_min rand_delay_sec
  local mode="$1" unit="$2" exec_path="$3" cfg="$4" ssh_key="$5" ssh_known="$6"
  local interval_min="$7" boot_delay_min="$8" rand_delay_sec="$9"

  need_cmd systemctl
  need_cmd install

  local service_content timer_content
  service_content=$(cat <<EOF
[Unit]
Description=critical-sync marker-based backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=CRITICAL_SYNC_CONFIG_FILE=$cfg
Environment=SSH_IDENTITY=$ssh_key
Environment=SSH_KNOWN_HOSTS=$ssh_known
ExecStart=$exec_path
EOF
)

  timer_content=$(cat <<EOF
[Unit]
Description=Run critical-sync periodically

[Timer]
OnBootSec=${boot_delay_min}min
OnUnitActiveSec=${interval_min}min
AccuracySec=1min
RandomizedDelaySec=${rand_delay_sec}
Persistent=true

[Install]
WantedBy=timers.target
EOF
)

  local tmp
  tmp="$(mktemp)"
  # Embed the path now so the trap doesn't reference a local variable later (set -u safe)
  local tmp_q
  printf -v tmp_q '%q' "$tmp"
  trap "rm -f -- $tmp_q" RETURN
  

  if [[ "$mode" == "system" ]]; then
    local dir="/etc/systemd/system"
    local svc="$dir/${unit}.service"
    local tmr="$dir/${unit}.timer"

    printf "%s\n" "$service_content" > "$tmp"
    if [[ "$(id -u)" -eq 0 ]]; then
      install -m 0644 "$tmp" "$svc"
    else
      sudo install -m 0644 "$tmp" "$svc"
    fi

    printf "%s\n" "$timer_content" > "$tmp"
    if [[ "$(id -u)" -eq 0 ]]; then
      install -m 0644 "$tmp" "$tmr"
    else
      sudo install -m 0644 "$tmp" "$tmr"
    fi

    if [[ "$(id -u)" -eq 0 ]]; then
      systemctl daemon-reload
      systemctl enable --now "${unit}.timer"
    else
      sudo systemctl daemon-reload
      sudo systemctl enable --now "${unit}.timer"
    fi

    echo "Created + enabled system timer: ${unit}.timer"
    return 0
  fi

  # user mode
  local udir="$USER_HOME/.config/systemd/user"
  mkdir -p "$udir"
  local usvc="$udir/${unit}.service"
  local utmr="$udir/${unit}.timer"

  printf "%s\n" "$service_content" > "$usvc"
  printf "%s\n" "$timer_content" > "$utmr"

  # Try enabling; may depend on user session
  if [[ "$(id -u)" -eq 0 && -n "${SUDO_USER:-}" ]]; then
    local uid
    uid="$(id -u "$SUDO_USER")"
    sudo -u "$SUDO_USER" XDG_RUNTIME_DIR="/run/user/$uid" systemctl --user daemon-reload || true
    sudo -u "$SUDO_USER" XDG_RUNTIME_DIR="/run/user/$uid" systemctl --user enable --now "${unit}.timer" || true
  else
    systemctl --user daemon-reload || true
    systemctl --user enable --now "${unit}.timer" || true
  fi

  echo "Created user timer files at: $udir"
  echo "If it didn't enable (common on headless boxes), run as the user:"
  echo "  systemctl --user enable --now ${unit}.timer"
}


# Init wizard
init_wizard() {
  if ! is_tty; then
    echo "ERROR: --init requires an interactive terminal." >&2
    exit 1
  fi

  mkdir -p "$CONFIG_DIR"
  umask 077

  echo
  echo "critical-sync init"
  echo "Config will be written to: $CONFIG_FILE"
  echo

  local -a SOURCES=()
  local -a LOCAL_BACKUP_ROOTS=()
  local -a REMOTE_HOSTS=()
  local -a REMOTE_DESTS=()
  local -a REMOTE_NOTIFY_OFFLINE=()

  local v=""

  # Sources
  while true; do
    prompt_nonempty "Enter a source root to scan (absolute path recommended):" v
    v="$(norm_path "$v")"
    v="${v%/}"
    if [[ ! -d "$v" ]]; then
      echo "WARN: '$v' does not exist as a directory right now."
      if ! ask_yn "Add it anyway?" "N"; then
        continue
      fi
    fi
    SOURCES+=("$v")
    if ! ask_yn "Add another source root?" "N"; then
      break
    fi
  done

  # Local backups
  echo
  echo "Local backup roots:"
  echo "These are the directories that will receive the mirrored '!critical' folders."
  echo

  while true; do
    prompt_nonempty "Enter a local backup root directory:" v
    v="$(norm_path "$v")"
    v="${v%/}"
    mkdir -p "$v"
    warn_if_same_fs_any_source "$v" "${SOURCES[@]}"
    LOCAL_BACKUP_ROOTS+=("$v")
    if ! ask_yn "Add another local backup root?" "N"; then
      break
    fi
  done

  # Remote targets
  echo
  echo "Remote targets:"
  echo "Each target is an SSH host (user@host) plus a destination directory on that host."
  echo

  while true; do
    local host dest
    prompt_nonempty "Enter remote SSH target (user@host):" host
    prompt_nonempty "Enter remote destination directory on that host (e.g. ~/!critical):" dest

    host="${host#"${host%%[![:space:]]*}"}"; host="${host%"${host##*[![:space:]]}"}"
    dest="${dest#"${dest%%[![:space:]]*}"}"; dest="${dest%"${dest##*[![:space:]]}"}"

    local notify_offline=0
    if ask_yn "Notify (log) if this target is offline?" "Y"; then
      notify_offline=1
    fi

    REMOTE_HOSTS+=("$host")
    REMOTE_DESTS+=("$dest")
    REMOTE_NOTIFY_OFFLINE+=("$notify_offline")

    if ! ask_yn "Add another remote target?" "N"; then
      break
    fi
  done

  # Write config
  {
    echo "# critical-sync.conf"
    echo "# Generated: $(date -Is)"
    echo "# Edit as needed; this file is sourced by bash."
    echo
    echo "USE_CHECKSUM=${USE_CHECKSUM_DEFAULT}"
    echo
    write_array_block "EXCLUDES" "${EXCLUDES_DEFAULT[@]}"
    echo
    write_array_block "SOURCES" "${SOURCES[@]}"
    echo
    write_array_block "LOCAL_BACKUP_ROOTS" "${LOCAL_BACKUP_ROOTS[@]}"
    echo
    write_array_block "REMOTE_HOSTS" "${REMOTE_HOSTS[@]}"
    echo
    write_array_block "REMOTE_DESTS" "${REMOTE_DESTS[@]}"
    echo
    write_array_block "REMOTE_NOTIFY_OFFLINE" "${REMOTE_NOTIFY_OFFLINE[@]}"
    echo
    echo "# Optional overrides (uncomment to use):"
    echo "# LOGFILE=\"$CONFIG_DIR/critical-sync.log\""
    echo "# LOCKFILE=\"$CONFIG_DIR/critical-sync.lock\""
  } > "$CONFIG_FILE"

  echo
  echo "Wrote config: $CONFIG_FILE"
  echo

  # optional install into PATH
  local installed_path=""
  if ask_yn "Install 'critical-sync' into your PATH now?" "Y"; then
    local default_install
    if [[ "$(id -u)" -eq 0 ]]; then
      default_install="/usr/local/bin/critical-sync"
    else
      default_install="$USER_HOME/.local/bin/critical-sync"
    fi

    prompt_default "Install path" "$default_install" installed_path
    installed_path="$(norm_path "$installed_path")"

    if [[ -e "$installed_path" ]]; then
      if ! ask_yn "File exists at $installed_path. Overwrite?" "N"; then
        echo "Skipping install."
        installed_path=""
      fi
    fi

    if [[ -n "$installed_path" ]]; then
      install_self "$SCRIPT_SELF" "$installed_path"
      echo "Installed to: $installed_path"
    fi
  fi

  # optional systemd timer creation
  if ask_yn "Create a systemd timer to run critical-sync periodically?" "Y"; then
    if ! command -v systemctl >/dev/null 2>&1; then
      echo "WARN: systemctl not found; can't create a systemd timer on this system." >&2
      return 0
    fi

    local unit_name="critical-sync"
    local mode="system"
    local interval_min="15"
    local boot_delay_min="5"
    local rand_delay_sec="60"

    prompt_default "Timer unit name" "$unit_name" unit_name

    # Default mode:
    # - if root: system
    # - if not root: system (via sudo) is still usually what you want on a NAS
    if ask_yn "Create SYSTEM timer (recommended) instead of USER timer?" "Y"; then
      mode="system"
    else
      mode="user"
    fi

    prompt_int_default "Run every N minutes" "15" interval_min
    prompt_int_default "Delay after boot (minutes)" "5" boot_delay_min
    prompt_int_default "Randomized delay (seconds)" "60" rand_delay_sec

    # ExecStart: prefer installed path if we installed, else current script path
    local exec_path
    exec_path="${installed_path:-$SCRIPT_SELF}"

    # Ensure absolute path
    exec_path="$(readlink -f "$exec_path" 2>/dev/null || realpath "$exec_path" 2>/dev/null || echo "$exec_path")"

    # IMPORTANT for timers: point explicitly at config + ssh key locations
    local cfg_path ssh_key_path ssh_known_path
    cfg_path="$CONFIG_FILE"
    ssh_key_path="$SSH_IDENTITY"
    ssh_known_path="$SSH_KNOWN_HOSTS"

    create_systemd_timer "$mode" "$unit_name" "$exec_path" "$cfg_path" "$ssh_key_path" "$ssh_known_path" \
      "$interval_min" "$boot_delay_min" "$rand_delay_sec"
  fi
}


# Ensure config exists (or prompt to create)
if (( DO_INIT == 1 )); then
  init_wizard
fi

if [[ ! -f "$CONFIG_FILE" ]]; then
  if ! is_tty; then
    echo "ERROR: No config found at '$CONFIG_FILE' and no TTY available to prompt." >&2
    echo "Run interactively with: $0 --init" >&2
    exit 1
  fi

  echo "No config found at: $CONFIG_FILE"
  if ask_yn "Generate a config now?" "Y"; then
    init_wizard
  else
    echo "Aborting (no config)." >&2
    exit 1
  fi
fi

source "$CONFIG_FILE"


# Runtime defaults + validation

# If user removed/forgot these in config, set safe defaults
: "${USE_CHECKSUM:=${USE_CHECKSUM_DEFAULT}}"

declare -a EXCLUDES
if (( ${#EXCLUDES[@]} == 0 )); then
  EXCLUDES=("${EXCLUDES_DEFAULT[@]}")
fi

declare -a SOURCES
if (( ${#SOURCES[@]} == 0 )); then
  echo "ERROR: SOURCES is empty in config." >&2
  exit 2
fi

declare -a LOCAL_BACKUP_ROOTS
if (( ${#LOCAL_BACKUP_ROOTS[@]} == 0 )); then
  echo "ERROR: LOCAL_BACKUP_ROOTS is empty in config." >&2
  exit 2
fi

# Optional lock/log overrides; otherwise choose writable locations
LOCKFILE_DEFAULT="/var/lock/critical-sync.lock"
LOGFILE_DEFAULT="/var/log/critical-sync.log"

LOCKFILE="${LOCKFILE:-$LOCKFILE_DEFAULT}"
LOGFILE="${LOGFILE:-$LOGFILE_DEFAULT}"

# If not writable, fall back into config dir
mkdir -p "$CONFIG_DIR"
if ! ( : >> "$LOGFILE" ) 2>/dev/null; then
  LOGFILE="$CONFIG_DIR/critical-sync.log"
fi
if ! ( mkdir -p "$(dirname "$LOCKFILE")" && : >> "$LOCKFILE" ) 2>/dev/null; then
  LOCKFILE="$CONFIG_DIR/critical-sync.lock"
fi


# Lock so two runs don't overlap
mkdir -p "$(dirname "$LOCKFILE")"
exec 9>"$LOCKFILE"
flock -n 9 || exit 0


# Build rsync options
RSYNC_OPTS=(
  -aHAX --numeric-ids
  --delete --delete-delay
  --partial --delay-updates
  --mkpath
)

(( USE_CHECKSUM == 1 )) && RSYNC_OPTS+=( --checksum )
(( DRY_RUN == 1 )) && RSYNC_OPTS+=( --dry-run )

for pat in "${EXCLUDES[@]}"; do
  RSYNC_OPTS+=( "--exclude=$pat" )
done


# Logging helper
log() {
  local msg="[$(date -Is)] $*"
  echo "$msg" | tee -a "$LOGFILE"
}


# Ensure local backup roots exist
for b in "${LOCAL_BACKUP_ROOTS[@]}"; do
  mkdir -p "$b"
done


# Collect unique directories containing "!critical"
declare -A CRIT_DIRS=()   # dir -> source_root

for root in "${SOURCES[@]}"; do
  root="${root%/}"
  if [[ ! -d "$root" ]]; then
    log "WARN: source root missing: $root"
    continue
  fi

  while IFS= read -r -d '' marker; do
    dir="$(dirname "$marker")"
    CRIT_DIRS["$dir"]="$root"
  done < <(find "$root" -xdev -type f -name '!critical' -print0)
done

if (( ${#CRIT_DIRS[@]} == 0 )); then
  log "No !critical markers found. Nothing to do."
  exit 0
fi


# Prepare remote availability (per target)
declare -a REMOTE_HOSTS REMOTE_DESTS REMOTE_NOTIFY_OFFLINE
REMOTE_COUNT=${#REMOTE_HOSTS[@]}


remote_ok=()
for ((i=0; i<REMOTE_COUNT; i++)); do
  remote_ok[$i]=0
  host="${REMOTE_HOSTS[$i]}"
  dest="${REMOTE_DESTS[$i]}"

  # Ensure base destination exists, if unreachable, mark offline
  if ssh "${SSH_BASE_OPTS[@]}" "$host" "mkdir -p -- $dest" >/dev/null 2>&1; then
    remote_ok[$i]=1
  else
    remote_ok[$i]=0
    log "WARN: remote target offline/unreachable: $host (dest=$dest)"
    if [[ "${REMOTE_NOTIFY_OFFLINE[$i]:-0}" -eq 1 ]]; then
      notify "critical-sync: remote target offline: $host (dest=$dest)"
    fi
  fi
done


# Sync one critical folder
sync_one() {
  local src_dir="$1"
  local src_root="$2"

  local root_tag rel
  root_tag="$(basename "$src_root")"

  if [[ "$src_dir" == "$src_root" ]]; then
    rel="__ROOT__"
  else
    rel="${src_dir#"$src_root"/}"
  fi

  log "SYNC: $src_dir"

  # Local backups
  for b in "${LOCAL_BACKUP_ROOTS[@]}"; do
    local dst="${b}/${root_tag}/${rel}"
    log "  -> local:   $dst"
    if ! rsync "${RSYNC_OPTS[@]}" -- "$src_dir/" "$dst/"; then
      log "ERROR: rsync to local backup failed: $dst (src=$src_dir)"
    fi
  done

  # Remote backups
  for ((i=0; i<REMOTE_COUNT; i++)); do
    if [[ "${remote_ok[$i]}" -ne 1 ]]; then
      continue
    fi
    local host="${REMOTE_HOSTS[$i]}"
    local base="${REMOTE_DESTS[$i]}"
    local dst="${base}/${root_tag}/${rel}"
    log "  -> remote:  $host:$dst"
    if ! rsync -e "$RSYNC_SSH" "${RSYNC_OPTS[@]}" -- "$src_dir/" "$host:$dst/"; then
      log "ERROR: rsync to remote failed: $host:$dst (src=$src_dir)"
    fi
  done
}

log "Run started (dry_run=$DRY_RUN checksum=$USE_CHECKSUM). Found ${#CRIT_DIRS[@]} critical folder(s)."
for dir in "${!CRIT_DIRS[@]}"; do
  sync_one "$dir" "${CRIT_DIRS[$dir]}"
done
log "Run finished."
